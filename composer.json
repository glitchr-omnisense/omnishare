{
    "name": "omniscient/omnishare",
    "type": "library",
    "description": "Omnishare: share links to social networks - a page's address, title, text, picture and hashtags turned into each network's own share page (Facebook, X, Pinterest, LinkedIn, Bluesky, Mastodon, Threads, WhatsApp, Telegram, Reddit), an e-mail, a copied link and the device's share sheet. Plain links: no network script, no cookie, no credential. One JSON for Twig, Blade and React.",
    "keywords": ["share", "share links", "share buttons", "social", "facebook", "x", "twitter", "pinterest", "linkedin", "bluesky", "mastodon", "threads", "whatsapp", "telegram", "reddit", "omnishare"],
    "homepage": "https://github.com/glitchr-studio/omnishare",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnishare\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/",
            "/docker/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnishare\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
